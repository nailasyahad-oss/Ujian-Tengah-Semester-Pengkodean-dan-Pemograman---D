erDiagram
    CHART_OF_ACCOUNTS {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        varchar20 kode_akun UK "UNIQUE NOT NULL"
        varchar200 nama_akun "NOT NULL"
        varchar10 normal_balance "CHECK salah-satu dari DEBIT atau CREDIT"
        varchar20 classification "CHECK salah-satu dari ASET LIABILITAS EKUITAS PENDAPATAN BEBAN"
        timestamptz created_at "DEFAULT now"
    }

    JOURNAL_HEADERS {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        date tanggal_transaksi "NOT NULL"
        varchar50 nomor_referensi UK "UNIQUE NOT NULL, nomor bukti transaksi"
        text deskripsi "keterangan transaksi"
        varchar20 status_posting "CHECK salah-satu dari DRAFT POSTED REVERSED, default DRAFT"
        timestamptz created_at "DEFAULT now"
        timestamptz posted_at "waktu posting, NULL jika DRAFT"
    }

    JOURNAL_LINES {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        bigint header_id FK "NOT NULL, ON DELETE RESTRICT"
        bigint account_id FK "NOT NULL, ON DELETE RESTRICT"
        numeric18_2 debit "NOT NULL DEFAULT 0, CHECK debit tidak negatif"
        numeric18_2 credit "NOT NULL DEFAULT 0, CHECK credit tidak negatif"
        timestamptz created_at "DEFAULT now"
    }

    CHART_OF_ACCOUNTS ||--o{ JOURNAL_LINES : "satu akun dipakai di banyak line"
    JOURNAL_HEADERS ||--|{ JOURNAL_LINES : "satu header memiliki 1 atau lebih line"
